# Local dev only -- excluded from git and from `gcloud run deploy --source`
# uploads via .gcloudignore. Real Cloud Run deployment gets these same
# values via --set-secrets/--set-env-vars instead.

# --- Cyera Dataport MCP connection (required) ---
# Bearer token from the attached mcp.json (mcpServers.hosted-demov2.
# headers.Authorization, minus the "Bearer " prefix). Decoded (not
# verified) JWT claims: tenant_id f3720114-66d5-40cb-8ce3-05ef2c2c13ff,
# owner prashanth.charapalli@cyera.io, issued 2026-04-20, expires
# 2026-10-21 -- rotate before then (see README.md Known limitations).
CYERA_DATAPORT_MCP_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..fkI2bh9dTjB745cofyCsnp3FJl-Pjf0cqgpCZKoPlp4VkXEzVnnMV63ZXFBzibkojMGAkPhLIDcIPSsf2Sh7YG2o8kKQlAzG91z0VUrPThUyK9eUsHMx9cCSpgy2UR6Q7qtTR78rsb1gqHlK5-9yn9tjqY5XDNaiR1vHUz0k2LfcKkOddPdVT8UjW-PqaWZpejQEkR3ITdCiRJtV8aeAq-OUCzr8tABN776jQfZEpYer4VNTAJQv3NOIBBIhvroGCDNFfIM8NckxhwSm9e5LUlsy176DqHHzI-YZMwzsYH1asPhtwafJmYmOQVxkeIlnLOcU8-ev2Iseojy4fPMT2A

# Verified live to be the working endpoint (Streamable HTTP) -- NOT the
# literal "/sse" URL in the attached mcp.json. See agent.py's module
# docstring.
CYERA_DATAPORT_MCP_URL=https://mcp.cyera.io/public/dataport/mcp

# --- Model credentials (required, choose ONE) ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Model (optional) ---
# ADK_MODEL=gemini-3.8-flash
# gemini-3.8-flash (this agent's own current default, see agent.py) is
# only served via Vertex AI's "global" endpoint as of 2026-09-22 --
# confirmed live. Deliberately a DIFFERENT key from GOOGLE_CLOUD_LOCATION
# above (which Deployment_artifacts/deploy.ps1/.sh also use as the CLOUD
# RUN deploy region's own default) -- see Resolve-ModelCredentialConfig's/
# resolve_model_credentials()'s own comments for why conflating the two
# would break `gcloud run deploy --region global` (not a valid region).
VERTEX_MODEL_LOCATION=global

# --- Identity gate (optional) ---
# IDENTITY_PLATFORM_PROJECT_ID=boris-scc-gcp-project

# --- A2A public agent card (optional -- set after first Cloud Run deploy) ---
# A2A_HOST=cyera-dataport-agent-<hash>-uc.a.run.app
# A2A_PORT=443
# A2A_PROTOCOL=https

# --- Local server port (optional) ---
# PORT=8080

# --- Gemini Enterprise Agent Gateway access (optional) ---
# Deploy-time only (not read by this agent's own code -- see
# auth_middleware.py's module docstring for why app-level verification of
# Gemini Enterprise's X-Serverless-Authorization header was abandoned).
# Deployment_artifacts/deploy.ps1/.sh use this to grant roles/run.invoker
# on this --no-allow-unauthenticated Cloud Run service to
# service-<PROJECT_NUMBER>@gcp-sa-discoveryengine.iam.gserviceaccount.com
# (Gemini Enterprise's own Discovery Engine service agent), so its Agent
# Gateway can reach this agent at all. This is cyera-scc-integration's own
# project NUMBER (not ID) -- confirmed live via `gcloud projects describe`.
GEMINI_ENTERPRISE_PROJECT_NUMBER=67025906140
